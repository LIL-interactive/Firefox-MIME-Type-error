{
  "manifest_version": 2,
  "name": "Video MIME Fix",
  "version": "1.0.0",
  "description": "Исправляет «Видео в поддерживаемом формате и MIME-типе не найдено» в Firefox: подставляет правильный Content-Type и объясняет, какой кодек не поддерживается.",
  "browser_specific_settings": {
    "gecko": {
      "id": "video-mime-fix@lil-interactive",
      "strict_min_version": "115.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  },
  "icons": {
    "48": "icons/icon.svg",
    "96": "icons/icon.svg"
  },
  "permissions": [
    "webRequest",
    "webRequestBlocking",
    "storage",
    "downloads",
    "<all_urls>"
  ],
  "background": {
    "scripts": [
      "probe.js",
      "background.js"
    ],
    "persistent": true
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_start",
      "all_frames": true
    }
  ],
  "browser_action": {
    "default_title": "Video MIME Fix",
    "default_icon": "icons/icon.svg",
    "default_popup": "popup.html"
  }
}
